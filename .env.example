# Reference only. The processes do not automatically load .env.
HARNESS_ENABLED=false
DATABASE_URL=postgres://fixture@127.0.0.1:5432/harness_test
LINE_CHANNEL_SECRET=replace-with-channel-secret
HOST=127.0.0.1
PORT=3000
# API runtime (all required when enabled; placeholders intentionally fail validation)
LINE_CHANNEL_ID=replace-with-messaging-channel-id
LINE_BOT_ID=replace-with-bot-user-id
LINE_HARNESS_PROFILE=group-harness
LINE_API_ACCESS_TOKEN=replace-with-api-token
LINE_LOGIN_CHANNEL_ID=replace-with-login-channel-id
REPLY_ENCRYPTION_KEY=replace-with-independent-32-byte-lowercase-hex-key
ASSET_SOURCE_GATE_TOKEN=replace-with-independent-32-byte-lowercase-hex-token
ACCOUNT_API_ORIGIN=https://account.example.invalid
ACCOUNT_HARNESS_PRIVATE_TOKEN=replace-with-independent-32-byte-lowercase-hex-token
ADMIN_ORIGIN=https://admin.example.invalid
ASSET_API_ORIGIN=https://asset.example.invalid
ASSET_WORKLOAD_TOKEN=replace-with-dedicated-workload-token
HARNESS_QUEUE_URL=https://storageaccount.queue.core.windows.net/harness
AZURE_CLIENT_ID=replace-with-dedicated-managed-identity-client-id
# Worker only; do not copy API/Account/Reply credentials into its environment.
LINE_DOWNLOAD_ACCESS_TOKEN=replace-with-worker-download-token
ASSET_UPLOAD_ORIGINS=https://storageaccount.blob.core.windows.net

# Dedicated Gateway to Harness human management admission, 64 lowercase hex; distinct from other credentials.
HARNESS_GATEWAY_PRIVATE_TOKEN=

# Optional natural-language Agent; disabled until provider/account acceptance.
AGENT_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-terra
# AZURE_OPENAI_ENDPOINT=https://RESOURCE.openai.azure.com/openai/v1/
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_TARIFF_JSON={"inputMicrosPerMillion":1000000,"outputMicrosPerMillion":5000000,"cachedInputMicrosPerMillion":50000,"cacheWriteMicrosPerMillion":1250000,"cacheWriteLongMicrosPerMillion":2500000}
# AZURE_OPENAI_TARIFF_JSON=  # Supply separately verified Azure tariff; do not copy OpenAI rates.

# Optional text embedding version. Keep disabled until model/dimension/rate validation.
EMBEDDING_ENABLED=false
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=
# EMBEDDING_RESPONSE_MODEL=
# EMBEDDING_VERSION=
# EMBEDDING_DIMENSIONS=
# EMBEDDING_INPUT_MICROS_PER_MILLION=
# The dedicated embedding worker needs only DATABASE_URL, LINE_CHANNEL_ID and
# the selected model's credential/identity settings. No LINE/Asset/Account/Reply secrets.

# Optional local delivery; both required together. Independent from legacy Audit.
# Production admission requires verified receiver/transport and alert routing.
# AUDIT_API_ORIGIN=https://private-audit-origin/
# AUDIT_HARNESS_TOKEN=<independent-32-byte-lowercase-hex>

# Pin the independently recorded restore generation before restarting API/workers.
HARNESS_RUNTIME_GENERATION=1
# Operator-only; keep outside DB backups and never provide to API/media workers.
# RESTORE_JOURNAL_KEY=<independent-32-byte-lowercase-hex>
